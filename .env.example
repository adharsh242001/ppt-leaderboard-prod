# =============================================================================
# PPT Leaderboard — Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Vercel deployment, set these in the Vercel project dashboard.
# For Docker VPS deployment, use .env.production.example instead.
# =============================================================================

# --- Supabase (required for Vercel hosting) ---
# Project URL from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Service role key (secret! never expose to the browser).
# Used server-side for Storage operations (upload/delete photos).
# From Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (PostgreSQL) ---
# For local dev: local Postgres instance.
# For Vercel: Supabase Postgres connection string.
DATABASE_URL=postgresql://ppt_user:change-this-db-password@localhost:5432/ppt_leaderboard?schema=public

# PostgreSQL credentials — used by the postgres container in docker-compose.yml.
POSTGRES_DB=ppt_leaderboard
POSTGRES_USER=ppt_user
POSTGRES_PASSWORD=change-this-db-password

# --- Admin Authentication ---
# Single admin account bootstrapped on first auth use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Secret used as a server-side pepper when hashing session tokens.
# Must be at least 32 characters long. Use a cryptographically random string.
SESSION_SECRET=replace-with-a-long-random-session-secret

# --- Runtime ---
NODE_ENV=production        # Controls Prisma log level & cookie secure flag
PORT=3000                  # Internal port the Next.js server listens on
HOSTNAME=0.0.0.0           # Bind address (0.0.0.0 = all interfaces)

# --- Docker (optional) ---
# Host port binding for the app container (docker-compose.yml).
# For production behind Nginx, set to 127.0.0.1:3000 to keep it local.
APP_PORT_BIND=3000
PUBLIC_DOMAIN=leaderboard.example.com
LETSENCRYPT_EMAIL=you@example.com
