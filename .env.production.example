# --- Supabase (for Vercel hosting) ---
# Project URL from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service role key (secret! never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (PostgreSQL) ---
# For Docker VPS: local Postgres service (see POSTGRES_* vars below).
#   DATABASE_URL=postgresql://ppt_user:replace-with-a-very-strong-db-password@postgres:5432/ppt_leaderboard?schema=public
#
# For Vercel: Supabase Postgres via session pooler (port 6543).
#   DATABASE_URL=postgresql://[project].[user]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=30&schema=public
DATABASE_URL=postgresql://change-me:change-me@change-me.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=30&schema=public

POSTGRES_DB=ppt_leaderboard
POSTGRES_USER=ppt_user
POSTGRES_PASSWORD=replace-with-a-very-strong-db-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-very-strong-admin-password
SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-chars

# Secret for the vote-processing cron endpoint (/api/process-votes).
# Pass as Authorization: Bearer <secret> or ?secret=<secret> when calling from a cron service.
# Falls back to admin session check if not set.
CRON_SECRET=replace-with-a-random-cron-secret

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_PORT_BIND=127.0.0.1:3000
PUBLIC_DOMAIN=leaderboard.example.com
LETSENCRYPT_EMAIL=you@example.com
